# Identificador público do cliente AdSense, no formato ca-pub-0000000000000000.
# Deixe vazio até sua conta e o domínio estarem aprovados.
VITE_ADSENSE_CLIENT_ID=

# IDs dos blocos de anúncio criados no AdSense.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_CATALOG=

# Caminho da unidade de anúncio recompensado criada no Google Ad Manager,
# por exemplo: /1234567/fortflix-rewarded. Configure recompensa = 50 créditos.
VITE_GAM_REWARDED_AD_UNIT_PATH=
